# ktlint configuration for apps/api. Self-contained (root = true) so the Kotlin
# toolchain is not affected by editor settings elsewhere in the monorepo.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.{kt,kts}]
ktlint_code_style = ktlint_official
max_line_length = 140
ij_kotlin_allow_trailing_comma = true
ij_kotlin_allow_trailing_comma_on_call_site = true

[*.{yaml,yml,json,toml}]
indent_size = 2
